prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log
Description: Abseil log library
URL: https://abseil.io/
Version: 20260526
Requires: absl_log_internal_log_impl = 20260526, absl_vlog_is_on = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
