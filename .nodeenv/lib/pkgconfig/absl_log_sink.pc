prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_sink
Description: Abseil log_sink library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_log_entry = 20260526
Libs: -L${libdir}  -labsl_log_sink 
Cflags: -I${includedir} -DNOMINMAX
