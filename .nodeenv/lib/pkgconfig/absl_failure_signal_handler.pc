prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_failure_signal_handler
Description: Abseil failure_signal_handler library
URL: https://abseil.io/
Version: 20260526
Requires: absl_examine_stack = 20260526, absl_stacktrace = 20260526, absl_base = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_raw_logging_internal = 20260526
Libs: -L${libdir}  -labsl_failure_signal_handler 
Cflags: -I${includedir} -DNOMINMAX
