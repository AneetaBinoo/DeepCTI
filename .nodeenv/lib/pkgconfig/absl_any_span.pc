prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_any_span
Description: Abseil any_span library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_hardening = 20260526, absl_nullability = 20260526, absl_raw_logging_internal = 20260526, absl_throw_delegate = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
