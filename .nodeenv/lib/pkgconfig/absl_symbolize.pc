prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_symbolize
Description: Abseil symbolize library
URL: https://abseil.io/
Version: 20260526
Requires: absl_debugging_internal = 20260526, absl_demangle_internal = 20260526, absl_base = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_dynamic_annotations = 20260526, absl_malloc_internal = 20260526, absl_raw_logging_internal = 20260526, absl_strings = 20260526
Libs: -L${libdir}  -labsl_symbolize 
Cflags: -I${includedir} -DNOMINMAX
