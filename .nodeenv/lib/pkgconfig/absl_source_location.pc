prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_source_location
Description: Abseil source_location library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_nullability = 20260526
Libs: -L${libdir}  -labsl_source_location 
Cflags: -I${includedir} -DNOMINMAX
