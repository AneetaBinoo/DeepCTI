prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_internal_strip
Description: Abseil log_internal_strip library
URL: https://abseil.io/
Version: 20260526
Requires: absl_core_headers = 20260526, absl_log_internal_message = 20260526, absl_log_internal_nullstream = 20260526, absl_log_severity = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
