prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_profile_builder
Description: Abseil profile_builder library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_raw_logging_internal = 20260526, absl_flat_hash_map = 20260526, absl_btree = 20260526, absl_strings = 20260526, absl_str_format = 20260526, absl_span = 20260526
Libs: -L${libdir}  -labsl_profile_builder 
Cflags: -I${includedir} -DNOMINMAX
