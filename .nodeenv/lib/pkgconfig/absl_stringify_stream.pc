prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_stringify_stream
Description: Abseil stringify_stream library
URL: https://abseil.io/
Version: 20260526
Requires: absl_string_view = 20260526, absl_config = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
