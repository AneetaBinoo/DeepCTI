prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_debugging
Description: Abseil debugging library
URL: https://abseil.io/
Version: 20260526
Requires: absl_stacktrace = 20260526, absl_leak_check = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
