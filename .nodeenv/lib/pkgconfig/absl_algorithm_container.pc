prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_algorithm_container
Description: Abseil algorithm_container library
URL: https://abseil.io/
Version: 20260526
Requires: absl_algorithm = 20260526, absl_hardening = 20260526, absl_config = 20260526, absl_iterator_traits_internal = 20260526, absl_core_headers = 20260526, absl_meta = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
