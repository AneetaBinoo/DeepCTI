prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_sink_registry
Description: Abseil log_sink_registry library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_log_sink = 20260526, absl_log_internal_log_sink_set = 20260526, absl_nullability = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
