Version: 20260526
Requires: absl_container_memory = 20260526, absl_core_headers = 20260526, absl_hash_container_defaults = 20260526, absl_node_slot_policy = 20260526, absl_raw_hash_set = 20260526, absl_algorithm_container = 20260526, absl_memory = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
