prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_hashtable_profiler
Description: Abseil hashtable_profiler library
URL: https://abseil.io/
Version: 20260526
Requires: absl_profile_builder = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_strings = 20260526, absl_span = 20260526, absl_hashtablez_sampler = 20260526
Libs: -L${libdir}  -labsl_hashtable_profiler 
Cflags: -I${includedir} -DNOMINMAX
