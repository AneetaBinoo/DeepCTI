prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_layout
Description: Abseil layout library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_debugging_internal = 20260526, absl_meta = 20260526, absl_strings = 20260526, absl_span = 20260526, absl_utility = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
