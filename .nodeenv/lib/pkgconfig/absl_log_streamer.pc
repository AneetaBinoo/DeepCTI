prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_streamer
Description: Abseil log_streamer library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_absl_log = 20260526, absl_log_severity = 20260526, absl_optional = 20260526, absl_source_location = 20260526, absl_strings = 20260526, absl_strings_internal = 20260526, absl_utility = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
