prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_statusor
Description: Abseil statusor library
URL: https://abseil.io/
Version: 20260526
Requires: absl_base = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_has_ostream_operator = 20260526, absl_nullability = 20260526, absl_raw_logging_internal = 20260526, absl_status = 20260526, absl_source_location = 20260526, absl_str_format = 20260526, absl_strings = 20260526, absl_type_traits = 20260526, absl_utility = 20260526, absl_variant = 20260526
Libs: -L${libdir}  -labsl_statusor 
Cflags: -I${includedir} -DNOMINMAX
