prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_globals
Description: Abseil log_globals library
URL: https://abseil.io/
Version: 20260526
Requires: absl_atomic_hook = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_hash = 20260526, absl_log_severity = 20260526, absl_raw_logging_internal = 20260526, absl_strings = 20260526, absl_vlog_config_internal = 20260526
Libs: -L${libdir}  -labsl_log_globals 
Cflags: -I${includedir} -DNOMINMAX
