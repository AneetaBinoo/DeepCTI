prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_cordz_statistics
Description: Abseil cordz_statistics library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_cordz_update_tracker = 20260526, absl_synchronization = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
