prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_flags
Description: Abseil log_flags library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_log_globals = 20260526, absl_log_severity = 20260526, absl_log_internal_config = 20260526, absl_log_internal_flags = 20260526, absl_flags = 20260526, absl_flags_marshalling = 20260526, absl_strings = 20260526, absl_vlog_config_internal = 20260526
Libs: -L${libdir}  -labsl_log_flags 
Cflags: -I${includedir} -DNOMINMAX
