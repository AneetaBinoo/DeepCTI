prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_fixed_array
Description: Abseil fixed_array library
URL: https://abseil.io/
Version: 20260526
Requires: absl_compressed_tuple = 20260526, absl_algorithm = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_dynamic_annotations = 20260526, absl_hardening = 20260526, absl_iterator_traits_internal = 20260526, absl_throw_delegate = 20260526, absl_memory = 20260526, absl_weakly_mixed_integer = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
