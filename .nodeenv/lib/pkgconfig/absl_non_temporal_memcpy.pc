URL: https://abseil.io/
Version: 20260526
Requires: absl_non_temporal_arm_intrinsics = 20260526, absl_config = 20260526, absl_core_headers = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
