prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_log_internal_globals
Description: Abseil log_internal_globals library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_log_severity = 20260526, absl_raw_logging_internal = 20260526, absl_strings = 20260526, absl_time = 20260526
Libs: -L${libdir}  -labsl_log_internal_globals 
Cflags: -I${includedir} -DNOMINMAX
