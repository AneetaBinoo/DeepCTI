prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_int128
Description: Abseil int128 library
URL: https://abseil.io/
Version: 20260526
Requires: absl_compare = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_bits = 20260526
Libs: -L${libdir}  -labsl_int128 
Cflags: -I${includedir} -DNOMINMAX
