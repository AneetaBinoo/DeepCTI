prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_charset
Description: Abseil charset library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_string_view = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
