prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_demangle_rust
Description: Abseil demangle_rust library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_decode_rust_punycode = 20260526
Libs: -L${libdir}  -labsl_demangle_rust 
Cflags: -I${includedir} -DNOMINMAX
