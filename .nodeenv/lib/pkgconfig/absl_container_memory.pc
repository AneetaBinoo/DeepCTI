prefix=/storage/data/DeepCTI/.nodeenv
exec_prefix=${prefix}
libdir=/storage/data/DeepCTI/.nodeenv/lib
includedir=/storage/data/DeepCTI/.nodeenv/include

Name: absl_container_memory
Description: Abseil container_memory library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_hash = 20260526, absl_memory = 20260526, absl_type_traits = 20260526, absl_utility = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
