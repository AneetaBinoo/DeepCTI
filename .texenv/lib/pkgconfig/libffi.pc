prefix=/storage/data/DeepCTI/.texenv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
toolexeclibdir=${libdir}
includedir=/storage/data/DeepCTI/.texenv/include

Name: libffi
Description: Library supporting Foreign Function Interfaces
Version: 3.7.0
Libs: -L${toolexeclibdir} -lffi
Cflags: -I${includedir}
